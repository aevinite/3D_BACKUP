<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aevinite.owner-audit</string>

    <!-- WHAT LAUNCHD STARTS, AND WHY IT IS NODE (fixed 2026-08-06 — read scripts/launchagents/run-job.mjs).
         This used to be `/bin/zsh <the .sh>` and it had been dying INSTANTLY every night with
         `zsh: can't open input file`. macOS TCC protects ~/Documents and /bin/zsh has no Full Disk
         Access, so launchd could stat the script but never read it. /opt/homebrew/bin/node DOES
         have it (which is why com.aevinite.live-fix-watcher works), and a zsh it spawns inherits
         that access — both measured with probe agents. Do not put /bin/zsh back here. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/aevinite/Documents/Projects/backup_Menu/scripts/launchagents/run-job.mjs</string>
        <string>/Users/aevinite/Documents/Projects/backup_Menu/scripts/nightly-owner-audit.sh</string>
    </array>

    <!-- 6:00 AM local time (Asia/Calcutta), every day. Shifted from 4:00 so it does not
         collide with the 4:00 tablet audit on the one shared browser. launchd uses local time. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <!-- WHY THESE LOGS ARE NOT IN THE PROJECT FOLDER (fixed 2026-08-05).
         They used to be .claude/audits/*.log, i.e. inside ~/Documents — which macOS TCC
         protects. launchd could not create them, so it never even started the job and
         reported `last exit code = 78: EX_CONFIG`. Nothing surfaced that: the job simply
         never ran, there was no report in .claude/audits/, and only `launchctl list` knew.
         The proof is the sibling agents: com.aevinite.live-fix-watcher logs to ~/.claude/
         and has run 3,800+ times at exit 0, while all three audit agents logged into
         ~/Documents and all three were dead. ~/Library/Logs is not TCC-gated.
         The script cd's to the project itself, so WorkingDirectory is not needed either —
         and it was a second TCC-protected path launchd had to resolve before starting. -->
    <key>StandardOutPath</key>
    <string>/Users/aevinite/Library/Logs/aevidine/owner-audit.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aevinite/Library/Logs/aevidine/owner-audit.err.log</string>
</dict>
</plist>
