<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly REPAIR agent. Tracked copy — the live one lives at
  ~/Library/LaunchAgents/com.aevinite.nightly-repair.plist.
  ENABLE:  cp scripts/launchagents/com.aevinite.nightly-repair.plist ~/Library/LaunchAgents/ \
           && launchctl load ~/Library/LaunchAgents/com.aevinite.nightly-repair.plist
  DISABLE: launchctl unload ~/Library/LaunchAgents/com.aevinite.nightly-repair.plist
  Runs at 02:30 local — before the 04:00 tablet + 06:00 owner audits (one shared browser).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aevinite.nightly-repair</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/aevinite/Documents/Projects/backup_Menu/scripts/nightly-repair.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <!-- WHY THESE LOGS ARE NOT IN THE PROJECT FOLDER (fixed 2026-08-05).
         They used to be .claude/audits/*.log, i.e. inside ~/Documents — which macOS TCC
         protects. launchd could not create them, so it never even started the job and
         reported `last exit code = 78: EX_CONFIG`. Nothing surfaced that: the job simply
         never ran, there was no report in .claude/audits/, and only `launchctl list` knew.
         The proof is the sibling agents: com.aevinite.live-fix-watcher logs to ~/.claude/
         and has run 3,800+ times at exit 0, while all three audit agents logged into
         ~/Documents and all three were dead. ~/Library/Logs is not TCC-gated.
         The script cd's to the project itself, so WorkingDirectory is not needed either —
         and it was a second TCC-protected path launchd had to resolve before starting. -->
    <key>StandardOutPath</key>
    <string>/Users/aevinite/Library/Logs/aevidine/nightly-repair.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aevinite/Library/Logs/aevidine/nightly-repair.err.log</string>
</dict>
</plist>
