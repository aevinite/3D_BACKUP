#!/bin/bash
# ───────────────────────────────────────────────────────────────
#  Double-click this file to open the Competitor POS reference
#  in your default web browser. (macOS)
#
#  First time only: if macOS blocks it, right-click run.command →
#  Open → Open. After that, a normal double-click works.
# ───────────────────────────────────────────────────────────────
cd "$(dirname "$0")" || exit 1
echo "Opening  All Competitor POS — Owner Dashboards & Reports ..."
open "index.html"
